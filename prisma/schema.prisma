generator client {
  provider = "prisma-client-js"
}

generator prismaClassGenerator {
  provider                = "prisma-class-generator"
  output                  = "../src/generated/prisma-class"
  useSwagger              = true
  useClassValidator       = true
  dryRun                  = false
  separateRelationFields  = true
  usePrismaJsonValue      = true
  clientImportPath        = "../prisma-client/enums"
  preserveDefaultNullable = true
}

datasource db {
  provider = "postgresql"
}

// Models will be defined in the DB-schema issue.
